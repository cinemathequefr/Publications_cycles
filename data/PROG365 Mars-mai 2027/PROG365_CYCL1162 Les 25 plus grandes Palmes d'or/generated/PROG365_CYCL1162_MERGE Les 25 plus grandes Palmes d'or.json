          "idFilm": 39315,
          "titre": "Paris, Texas",
          "realisateurs": "Wim Wenders",
          "annee": 1984,
          "pays": "RFA-France-Grande-Bretagne",
          "duree": 148,
          "version": "VOSTF",
          "format": "DCP",
          "generique": [
            "Harry Dean Stanton",
            "Nastassja Kinski",
            "Dean Stockwell"
          ],
          "textes": [
            {
              "typeTexte": 1000,
              "texte": "Les riffs de Ry Cooder, Harry Dean Stanton et son visage buriné, le désert, le sable et les motels, la résurrection d'un homme et les retrouvailles avec son fils, une scène bouleversante à travers la glace sans tain d'un peep-show, la grâce et la douleur d'un amour incandescent. Et Nastassja Kinski. Wenders pose sur l'Amérique son regard d'inconditionnel passionné et réalise un chef-d'œuvre. La Palme d'or 1984."
            },
            {
              "typeTexte": 99,
              "texte": "Restauration 2K à partir du négatif original 35 mm, menée par Argos Films avec le soutien du CNC et sous la supervision de Wim Wenders."
            }
          ]
