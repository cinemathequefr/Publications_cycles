          "titre": "Des rêves en bateaux papiers",
          "titreVo": "Dreams Like Paper Boats",
          "realisateurs": "Samuel Suffren",
          "annee": 2024,
          "pays": "Haïti",
          "duree": 19,
          "version": "VOSTF",
